# Example environment for the perp-lab research platform (NO secrets).
# Copy to `.env` for docker-compose overrides. All values have safe defaults.

# ---- Quantitative API (FastAPI) ----------------------------------------------
# Root of the run-artifact directory (source of truth).
PERP_LAB_ARTIFACT_ROOT=artifacts
# Directory containing per-run search artifacts.
PERP_LAB_RUNS_DIR=artifacts/runs
# Dataset manifests (provenance + checksums).
PERP_LAB_MANIFESTS_DIR=data/manifests
# Validated data contract (holdout boundary, symbols, timeframes).
PERP_LAB_DATA_CONTRACT=configs/data_contract.yaml
# Comma-separated CORS allow-list (narrow by design).
PERP_LAB_CORS_ORIGINS=http://localhost:3000
# Max page size cap for list endpoints.
PERP_LAB_MAX_PAGE_SIZE=500
# Free-form environment tag surfaced in /health.
PERP_LAB_ENV=development

# ---- Web platform (Next.js) --------------------------------------------------
# Base URL the browser uses to reach the API. Inlined at BUILD time
# (NEXT_PUBLIC_*), so rebuild the web image if you change it.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# ---- Reserved services (documented, NOT deployed in this phase) ---------------
# MLFLOW_PORT=5000
# POSTGRES_PORT=5432        # internal only
# REDIS_PORT=6379           # internal only
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
