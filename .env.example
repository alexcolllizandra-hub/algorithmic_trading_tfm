# Example environment for the perp-lab research platform (NO secrets).
# Copy to `.env` for docker-compose overrides. All values have safe defaults.

# ---- Quantitative API (FastAPI) ----------------------------------------------
# Root of the run-artifact directory (source of truth).
PERP_LAB_ARTIFACT_ROOT=artifacts
# Directory containing per-run search artifacts.
PERP_LAB_RUNS_DIR=artifacts/runs
# Dataset manifests (provenance + checksums).
PERP_LAB_MANIFESTS_DIR=data/manifests
# Validated data contract (holdout boundary, symbols, timeframes).
PERP_LAB_DATA_CONTRACT=configs/data_contract.yaml
# Comma-separated CORS allow-list (narrow by design).
PERP_LAB_CORS_ORIGINS=http://localhost:3000
# Max page size cap for list endpoints.
PERP_LAB_MAX_PAGE_SIZE=500
# Free-form environment tag surfaced in /health.
PERP_LAB_ENV=development

# ---- Web platform (Next.js) --------------------------------------------------
# Base URL the browser uses to reach the API. Inlined at BUILD time
# (NEXT_PUBLIC_*), so rebuild the web image if you change it.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# ---- Web authentication (Supabase Auth) ---------------------------------------
# Both are safe to ship to the browser. The anon key grants no privilege beyond
# what row-level security allows; the SERVICE ROLE key must never appear here.
# Leave both EMPTY to run the site with authentication switched off: the public
# research content renders normally and the sign-in button is hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Study catalogue: database ------------------------------------------------
# SQLAlchemy URL of the catalogue. Leave EMPTY to use a local SQLite file under
# data/catalog/ — everything (migrations, repositories, tests) works offline
# with no credentials. For Supabase, the pooled PostgreSQL connection string:
#   postgresql+psycopg://<user>:<password>@<host>:6543/postgres
DATABASE_URL=

# ---- Study catalogue: object storage ------------------------------------------
# Backend for the bulk Parquet evidence: `local` (default) or `supabase`.
# Selecting `supabase` without the three variables below fails immediately.
PERP_LAB_OBJECT_STORE_BACKEND=local
# Root directory of the local object store.
PERP_LAB_OBJECT_STORE_ROOT=data/object_store

# ---- Supabase (only needed when the backend above is `supabase`) --------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key. SERVER-SIDE ONLY: it bypasses row-level security and must
# never be inlined into a browser bundle. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket holding the registered Parquet objects.
SUPABASE_STORAGE_BUCKET=

# ---- Reserved services (documented, NOT deployed in this phase) ---------------
# MLFLOW_PORT=5000
# POSTGRES_PORT=5432        # internal only
# REDIS_PORT=6379           # internal only
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
