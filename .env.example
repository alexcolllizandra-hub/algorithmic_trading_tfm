# Copy to .env and adjust as needed. All values are optional; sensible
# defaults live in configs/*.yaml. Environment variables override YAML.
#
# Nested settings use the delimiter "__". Example overrides:
# PERP_LAB__PATHS__DATA_ROOT=./data
# PERP_LAB__SEED=42

# CCXT is only used for incremental updates and needs NO API key for public
# market data. Provide keys only if you later hit stricter rate limits.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
