# Secrets for the welcome-email Edge Function. Copy to `.env` (git-ignored) and
# load with:
#
#   supabase secrets set --env-file ./supabase/functions/welcome-email/.env
#
# NEVER commit a real key, and never paste one into a chat or an issue. If a key
# is exposed anywhere, rotate it in the Resend dashboard before doing anything
# else — rotation is cheap, a leaked key is not.

# Resend API key (starts with re_).
RESEND_API_KEY=

# Verified sender. Without a verified domain in Resend you must use
# `onboarding@resend.dev`, which can only deliver to the account that owns the
# Resend project. With a verified domain, any recipient works.
WELCOME_FROM=Alx Systems <hola@quantivelasystems.com>

# Optional shared secret. When set, the function requires the webhook to send a
# matching `x-webhook-secret` header and returns 401 otherwise.
WELCOME_HOOK_SECRET=
