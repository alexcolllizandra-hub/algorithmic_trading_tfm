# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- uv / virtual environments ---
.venv/
.uv/

# --- Legacy stray virtualenv committed at repo root (to be removed) ---
/Lib/
/Scripts/
/Include/
/share/
/pyvenv.cfg
# Git is case-insensitive on Windows/macOS, so the `/Scripts/` rule above also
# swallowed the project's own `scripts/` directory and silently kept the EDA and
# audit helpers out of the repository. Re-include it explicitly.
!/scripts/
!/scripts/**
/scripts/__pycache__/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Node ---
node_modules/
.next/

# --- Working material kept out of the repository ---
# Superseded drafts, audits, roadmaps, inventories and thesis working files.
# They stay on disk under docs/history/ and are simply not tracked.
docs/history/
.cursor/
.claude/
logs/
reports/landing/
reports/figures/experiments/

# Supabase CLI local state: project ref, pooler URL and version pins. The edge
# function and the mail templates are tracked; this directory is machine state.
supabase/.temp/

# --- Data lake (large, reproducible from the data contract) ---
data/raw/
data/validated/
data/processed/
# Manifests are small provenance records and MUST be committed:
!data/manifests/
!data/manifests/**

# --- Heavy data artifacts anywhere (belt-and-suspenders) ---
*.zip
*.parquet
*.feather
*.csv
# Exception: the curated macro-events calendar is committed source, not market data.
!configs/altdata/*.csv
# Exception: chapter-6/7/8 evidence tables are thesis deliverables, not market data.
!reports/thesis/chapter_06/*.csv
!reports/thesis/chapter_07/*.csv
!reports/thesis/chapter_08/*.csv
# ...but the 110 MB hourly input matrix stays out of git (regenerable from artifacts).
reports/thesis/chapter_08/ch8_input_returns.csv
*.db
*.sqlite
*.sqlite3
*.h5
*.pkl
*.pickle
# ...but keep tiny committed provenance/config text:
!data/manifests/**

# --- Reports (generated artifacts) ---

# --- Jupyter ---
.ipynb_checkpoints/
notebooks/**/*.nbconvert.ipynb

# --- ML / experiment tracking (future phases) ---
mlruns/
mlartifacts/

# --- Reproducible run records (heavy; regenerated by the pipeline) ---
# Root-anchored: the unanchored form also swallowed the web route
# apps/web/src/app/(dashboard)/artifacts/ and kept its page out of the repo,
# the same failure mode the /Scripts/ rule above already documents.
/artifacts/

# --- Offline study catalogue (rebuildable index; the artifacts are the truth) ---
data/catalog/
data/object_store/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
.coverage.*

# --- Logs / temp / heavy results ---
*.log
*.tmp
*.temp
logs/
tmp/
outputs/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Probe artifacts ---
shell_probe.txt
probe*.txt

# Supabase CLI scratch state (project ref, pooler URL, tool versions).
supabase/.temp/
